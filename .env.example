# Jev. Create a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Optional. Pin a version (e.g. jev-1.13.0) once cutoffs are tuned. It is part of the fingerprint,
# so changing it re-judges every record.
# JEV_MODEL=jev-latest

# Step 3 drafts. Both are needed; without them, records that need a draft go to a person.
# WRITER_MODEL is an OpenRouter model id. There is no default on purpose.
OPENROUTER_API_KEY=
WRITER_MODEL=

# Optional. Point drafts at another OpenAI-compatible endpoint (for example a CloakPipe proxy).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Where the answers, facts and ledger live.
# JEV_GTM_PLAYBOOK_DB=data/playbook.db

# Optional. Port for the localhost dashboard.
# PORT=4173

# Optional. Set to 1 to use made-up answers for the network commands (no key needed).
# JEV_MOCK=1

# Optional. Enrichment providers for "node src/cli.js enrich <provider>". Only set the ones you use.
# PROSPEO_API_KEY=
# LEADMAGIC_API_KEY=
# BLITZ_API_KEY=
# MOLTSETS_API_KEY=
